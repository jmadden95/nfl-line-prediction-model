# The Odds API key (free tier 500 credits/month, SHARED with nrl-line if you reuse its key).
ODDS_API_KEY=your_key_here
# Regions: au = books you bet with; eu = Pinnacle (sharp reference). Credits/call = markets x regions.
ODDS_REGIONS=au,eu
ODDS_MARKETS=h2h,spreads,totals
# Page cache for live odds (seconds). Pollers bypass it and refresh it.
ODDS_CACHE_TTL=43200
AU_BOOK=sportsbet
SHARP_BOOKS=pinnacle
# ntfy (homelab). Blank NTFY_URL/TOPIC disables pushes.
NTFY_URL=http://192.168.1.104:8088
NTFY_TOPIC=nfl-line
NTFY_TOKEN=
ALERT_MOVE_THRESHOLD=1.5
SHARP_LAG_MIN=1.0
